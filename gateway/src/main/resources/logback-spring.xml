<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ============================================================
         可外部化属性
         优先级：系统属性 / 启动参数 > application.yml > 默认值
         ============================================================ -->
    <springProperty name="LOG_PATH"           source="logging.file.path"          defaultValue="./logs/gateway"/>
    <springProperty name="LOG_MAX_HISTORY"    source="logging.file.max-history"   defaultValue="30"/>
    <springProperty name="LOG_MAX_FILE_SIZE"  source="logging.file.max-size"      defaultValue="500MB"/>
    <springProperty name="LOG_TOTAL_SIZE_CAP" source="logging.file.total-size-cap" defaultValue="20GB"/>
    <springProperty name="LOG_PATTERN"        source="logging.pattern.console"
                    defaultValue="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} %X{traceId:--} - %msg%n"/>

    <!-- ============================================================
         控制台 Appender (开发环境使用)
         ============================================================ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============================================================
         主日志滚动文件 Appender (INFO+)
         - 按天 + 按大小双重滚动
         - 保留 ${LOG_MAX_HISTORY} 天
         - 总容量上限 ${LOG_TOTAL_SIZE_CAP}
         ============================================================ -->
    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/gpt-gateway.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/gpt-gateway.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============================================================
         ERROR 独立日志文件 Appender (用于监控报警)
         ============================================================ -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/gpt-gateway-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/gpt-gateway-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ============================================================
         Profile 策略
         - dev / default：控制台 + 文件
         - prod：仅文件（避免终端 I/O 开销）
         ============================================================ -->
    <springProfile name="dev | default">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ROLLING_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="ROLLING_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>

    <!-- ============================================================
         网关自身 DEBUG 日志 (仅写入文件，不污染控制台)
         ============================================================ -->
    <logger name="com.example.gateway" level="DEBUG" additivity="false">
        <appender-ref ref="ROLLING_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <springProfile name="dev | default">
            <appender-ref ref="CONSOLE"/>
        </springProfile>
    </logger>

    <!-- 抑制健康检查的冗余日志 -->
    <logger name="org.springframework.cloud.gateway" level="INFO"/>
    <logger name="org.springframework.cloud.loadbalancer" level="WARN"/>
    <logger name="com.alibaba.nacos" level="WARN"/>

</configuration>
